# Export these in your shell. The app does not automatically load .env files.
# Map separate access tokens to player names; replace this placeholder.
WAYFARER_TOKENS='{"replace-with-a-long-random-token":"alice"}'
WAYFARER_PORT=8000
WAYFARER_DB=data/wayfarer.sqlite3
WAYFARER_FRONTEND_DIR=frontend/dist
# Optional AI provider (set both together).
# WAYFARER_OPENAI_API_KEY=
# WAYFARER_OPENAI_MODEL=
# Full structured scenario drafts can use the complete provider time budget.
# WAYFARER_MODEL_TIMEOUT_SECONDS=300
