          "type": "string",
          "enum": [
            "unauthenticated",
            "not_found",
            "invalid_message",
            "invalid_cursor",
            "invalid_transition",
            "rate_limited",
            "snapshot_too_large",
            "service_unavailable"
          ]
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 30000
            },
            {
              "type": "null"
            }
          ]
        }
