        }
      },
      "required": [
        "type",
        "protocol_version",
        "subscription_id",
        "scope",
        "visibility_epoch",
        "cursor"
      ],
      "additionalProperties": false
    },
    "ActionUpdated": {
      "type": "object",
      "properties": {
