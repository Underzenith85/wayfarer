        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "SnapshotResource": {
      "oneOf": [
        {
          "$ref": "#/$defs/CampaignResource"
        },
        {
          "$ref": "#/$defs/SceneResource"
        },
        {
          "$ref": "#/$defs/CharacterResource"
        },
        {
          "$ref": "#/$defs/InventoryResource"
        },
        {
          "$ref": "#/$defs/ActionResource"
        }
      ]
    },
    "SnapshotResourceMessage": {
      "type": "object",
      "properties": {
        "type": {
          "const": "snapshot.resource"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "visibility_epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resource": {
          "$ref": "#/$defs/SnapshotResource"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "subscription_id",
        "scope",
        "visibility_epoch",
        "snapshot_id",
        "index",
        "resource"
      ],
      "additionalProperties": false
    },
    "SnapshotEnd": {
      "type": "object",
      "properties": {
