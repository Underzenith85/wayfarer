{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayfarer.invalid/contracts/v1/events.schema.json",
  "title": "Wayfarer scoped live protocol 1.0.0",
  "description": "Target contract for #48; runtime conformance belongs to #50/#45. First-message authentication; no gameplay writes over this socket.",
  "x-client-message-types": [
    "Authenticate",
    "Subscribe",
    "Acknowledge",
    "Unsubscribe",
    "Pong",
    "InterruptNarration"
  ],
  "x-server-message-types": [
    "Authenticated",
    "Subscribed",
    "SnapshotBegin",
    "SnapshotResourceMessage",
    "SnapshotEnd",
    "Ready",
    "ActionUpdated",
    "ProjectionInvalidated",
    "Reset",
    "Revoked",
    "Unsubscribed",
    "Ping",
    "StreamError",
    "NarrationStarted",
    "NarrationDelta",
    "NarrationEnded",
    "VoiceSegment"
  ],
  "x-limits": {
    "authentication_timeout_ms": 5000,
    "heartbeat_interval_ms": 15000,
    "heartbeat_timeout_ms": 10000,
    "max_client_message_bytes": 32000,
    "max_server_message_bytes": 8388608,
    "max_snapshot_bytes": 33554432,
    "max_pending_bytes": 16777216,
    "max_pending_frames": 256,
    "max_subscriptions": 4,
    "max_client_messages_per_minute": 120,
    "replay_retention_seconds": 1200,
    "max_replay_events": 10000,
    "max_connection_lifetime_seconds": 3600
  },
  "$defs": {
    "Scope": {
      "type": "object",
      "properties": {
        "campaign_id": {
          "$ref": "./schemas.json#/$defs/Id"
        },
        "scene_id": {
          "$ref": "./schemas.json#/$defs/Id"
        },
        "actor_id": {
          "$ref": "./schemas.json#/$defs/Id"
        }
      },
      "required": [
        "campaign_id",
        "scene_id",
        "actor_id"
      ],
      "additionalProperties": false
    },
    "Cursor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,512}$"
    },
    "Epoch": {
      "$ref": "./schemas.json#/$defs/Version"
    },
    "Authenticate": {
      "type": "object",
      "properties": {
        "type": {
          "const": "authenticate"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "credential": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "type",
        "request_id",
        "credential"
      ],
      "additionalProperties": false
    },
    "Subscribe": {
      "type": "object",
      "properties": {
        "type": {
          "const": "subscribe"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "resume": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "cursor": {
                  "$ref": "#/$defs/Cursor"
                },
                "visibility_epoch": {
                  "$ref": "#/$defs/Epoch"
                }
              },
              "required": [
                "cursor",
                "visibility_epoch"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "request_id",
        "subscription_id",
        "scope",
        "resume"
      ],
      "additionalProperties": false
    },
    "Acknowledge": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ack"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        }
      },
      "required": [
        "type",
        "request_id",
        "subscription_id",
        "cursor"
      ],
      "additionalProperties": false
    },
    "Unsubscribe": {
      "type": "object",
      "properties": {
        "type": {
          "const": "unsubscribe"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "request_id",
        "subscription_id"
      ],
      "additionalProperties": false
    },
    "Pong": {
      "type": "object",
      "properties": {
        "type": {
          "const": "heartbeat.pong"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "nonce": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "request_id",
        "nonce"
      ],
      "additionalProperties": false
    },
    "InterruptNarration": {
      "type": "object",
      "properties": {
        "type": {
          "const": "narration.interrupt"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        },
        "narration_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "request_id",
        "subscription_id",
        "narration_id"
      ],
      "additionalProperties": false
    },
    "Authenticated": {
      "type": "object",
      "properties": {
        "type": {
          "const": "authenticated"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "connection_id": {
          "type": "string",
          "format": "uuid"
        },
        "principal_id": {
          "$ref": "./schemas.json#/$defs/Id"
        },
        "expires_at": {
          "$ref": "./schemas.json#/$defs/Timestamp"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "connection_id",
        "principal_id",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "Subscribed": {
      "type": "object",
      "properties": {
        "type": {
          "const": "subscribed"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "visibility_epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "mode": {
          "type": "string",
          "enum": [
            "snapshot",
            "replay"
          ]
        }
      },
      "required": [
        "type",
        "protocol_version",
        "request_id",
        "subscription_id",
        "scope",
        "visibility_epoch",
        "mode"
      ],
      "additionalProperties": false
    },
    "SnapshotBegin": {
      "type": "object",
      "properties": {
        "type": {
          "const": "snapshot.begin"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "visibility_epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "resource_count": {
          "type": "integer",
          "minimum": 4,
          "maximum": 10000
        }
      },
      "required": [
        "type",
        "protocol_version",
        "subscription_id",
        "scope",
        "visibility_epoch",
        "snapshot_id",
        "cursor",
        "resource_count"
      ],
      "additionalProperties": false
    },
    "CampaignResource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "campaign"
        },
        "value": {
          "$ref": "./schemas.json#/$defs/Campaign"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "SceneResource": {
      "type": "object",
      "properties": {
        "kind": {
