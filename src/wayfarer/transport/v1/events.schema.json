        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "visibility_epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "previous_cursor": {
          "$ref": "#/$defs/Cursor"
        },
        "occurred_at": {
          "$ref": "./schemas.json#/$defs/Timestamp"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "causation_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "$ref": "./schemas.json#/$defs/Action"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "subscription_id",
        "scope",
        "visibility_epoch",
        "event_id",
        "cursor",
        "previous_cursor",
        "occurred_at",
        "correlation_id",
        "causation_id",
        "action"
      ],
      "additionalProperties": false
    },
    "ProjectionInvalidated": {
      "type": "object",
