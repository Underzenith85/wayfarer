          "const": "error"
        },
        "protocol_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "subscription_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
