            "title": "Modifiers",
            "type": "array"
          },
          "runtime_hooks": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Runtime Hooks",
            "type": "array"
          }
        },
        "required": [
          "profile_id"
