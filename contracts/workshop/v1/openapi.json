        "title": "TraitParameter",
        "type": "object"
      },
      "TraitRules": {
        "properties": {
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "maximum_level": {
            "default": 1,
            "title": "Maximum Level",
            "type": "integer"
          },
          "self_control": {
            "default": false,
            "title": "Self Control",
            "type": "boolean"
          },
          "parameters": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/TraitParameter"
            },
            "title": "Parameters",
            "type": "array"
          },
          "modifiers": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/TraitModifier"
