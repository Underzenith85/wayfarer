{
  "openapi": "3.1.0",
  "info": {
    "title": "Character workshop",
    "version": "1.0.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "CatalogOption": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/DefinitionKind"
          },
          "status": {
            "$ref": "#/components/schemas/ImplementationStatus"
          },
          "skill": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SkillSpec"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "trait": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TraitRules"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "status"
        ],
        "title": "CatalogOption",
        "type": "object"
      },
      "ControllingAttribute": {
        "enum": [
          "attribute:st",
          "attribute:dx",
          "attribute:iq",
          "attribute:ht",
          "secondary:will",
          "secondary:per"
        ],
        "title": "ControllingAttribute",
        "type": "string"
      },
      "DefinitionKind": {
        "enum": [
          "attribute",
          "secondary",
          "skill",
          "trait",
          "equipment"
        ],
        "title": "DefinitionKind",
        "type": "string"
      },
      "Difficulty": {
        "enum": [
          "easy",
          "average",
          "hard",
          "very-hard"
        ],
        "title": "Difficulty",
        "type": "string"
      },
      "ImplementationStatus": {
        "enum": [
          "implemented",
          "manual-adjudication",
          "unsupported"
        ],
        "title": "ImplementationStatus",
        "type": "string"
      },
      "ProfileOption": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "supported": {
            "title": "Supported",
            "type": "boolean"
          },
          "blockers": {
            "items": {
              "type": "string"
            },
            "title": "Blockers",
            "type": "array"
          }
        },
        "required": [
          "id",
          "version",
          "title",
          "supported",
          "blockers"
        ],
        "title": "ProfileOption",
        "type": "object"
      },
      "SkillDefault": {
        "properties": {
          "target": {
            "title": "Target",
            "type": "string"
          },
          "modifier": {
            "title": "Modifier",
            "type": "integer"
          }
        },
        "required": [
          "target",
          "modifier"
        ],
        "title": "SkillDefault",
        "type": "object"
      },
      "SkillPrerequisite": {
        "properties": {
          "target": {
            "title": "Target",
            "type": "string"
          },
          "minimum": {
            "default": 1,
            "title": "Minimum",
            "type": "integer"
          }
        },
        "required": [
          "target"
        ],
        "title": "SkillPrerequisite",
        "type": "object"
      },
      "SkillSpec": {
        "properties": {
          "attribute": {
            "$ref": "#/components/schemas/ControllingAttribute"
          },
          "difficulty": {
            "$ref": "#/components/schemas/Difficulty"
          },
          "reference": {
            "title": "Reference",
            "type": "string"
          },
          "defaults": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SkillDefault"
            },
            "title": "Defaults",
            "type": "array"
          },
          "prerequisites": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SkillPrerequisite"
            },
            "title": "Prerequisites",
            "type": "array"
          },
          "specialty": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Specialty"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "technique": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Technique"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "attribute",
          "difficulty",
          "reference"
        ],
        "title": "SkillSpec",
        "type": "object"
      },
      "Specialty": {
        "properties": {
          "family": {
            "title": "Family",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "optional_parent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Optional Parent"
          }
        },
        "required": [
          "family",
          "name"
        ],
        "title": "Specialty",
        "type": "object"
      },
      "Technique": {
        "properties": {
          "parent": {
            "title": "Parent",
            "type": "string"
          },
          "default_modifier": {
            "title": "Default Modifier",
            "type": "integer"
          },
          "maximum_modifier": {
            "default": 0,
            "title": "Maximum Modifier",
            "type": "integer"
          }
        },
        "required": [
          "parent",
          "default_modifier"
        ],
        "title": "Technique",
        "type": "object"
      },
      "TraitModifier": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "percent": {
            "title": "Percent",
            "type": "integer"
          },
          "exclusions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Exclusions",
            "type": "array"
          },
          "runtime_hook": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Runtime Hook"
          }
        },
        "required": [
          "id",
          "percent"
        ],
        "title": "TraitModifier",
        "type": "object"
      },
      "TraitParameter": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "kind": {
            "enum": [
              "text",
              "integer",
              "boolean"
            ],
            "title": "Kind",
            "type": "string"
          },
          "choices": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Choices",
            "type": "array"
          }
        },
        "required": [
          "name",
          "kind",
          "choices"
