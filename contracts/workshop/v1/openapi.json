            "default": null,
            "title": "Content Json"
          },
          "reason": {
            "default": "",
            "maxLength": 2000,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "id",
          "draft_id",
          "actor_id",
          "expected_revision",
          "expected_draft_revision"
