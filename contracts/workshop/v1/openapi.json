          "profiles": {
            "items": {
              "$ref": "#/components/schemas/ProfileOption"
            },
            "title": "Profiles",
            "type": "array"
          },
          "catalog": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Catalog",
            "type": "array"
          },
          "build_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Build Revision"
          },
          "points_available": {
            "title": "Points Available",
            "type": "integer"
          },
          "can_approve": {
            "title": "Can Approve",
            "type": "boolean"
          }
        },
        "required": [
          "active_profile",
          "profiles",
          "catalog",
          "build_revision",
          "points_available",
          "can_approve"
        ],
        "title": "WorkshopOptions",
        "type": "object"
      },
      "CharacterDraft": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "backstory": {
            "default": "",
            "maxLength": 10000,
            "title": "Backstory",
            "type": "string"
          },
          "purchases": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Purchase"
            },
            "maxItems": 1000,
            "title": "Purchases",
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "title": "CharacterDraft",
        "type": "object"
      },
      "CharacterProposal": {
        "additionalProperties": false,
        "properties": {
          "draft": {
            "$ref": "#/components/schemas/CharacterDraft"
          },
          "custom": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CustomConstruction"
            },
            "maxItems": 100,
            "title": "Custom",
            "type": "array"
          }
        },
        "required": [
          "draft"
        ],
        "title": "CharacterProposal",
        "type": "object"
      },
      "CustomConstruction": {
        "additionalProperties": false,
        "description": "A named grouping of purchased catalog components, never new mechanics.",
        "properties": {
          "id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "components": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Components",
            "type": "array"
          }
        },
        "required": [
          "id",
          "components"
        ],
        "title": "CustomConstruction",
        "type": "object"
      },
      "Purchase": {
        "additionalProperties": false,
        "properties": {
          "definition_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Definition Id",
            "type": "string"
          },
          "amount": {
            "default": 1,
            "maximum": 10000,
            "minimum": 1,
            "title": "Amount",
            "type": "integer"
          },
          "trait": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TraitOptions"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "definition_id"
        ],
        "title": "Purchase",
        "type": "object"
      },
      "TraitOptions": {
        "additionalProperties": false,
        "properties": {
          "parameters": {
            "default": [],
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              ],
              "type": "array"
            },
            "title": "Parameters",
            "type": "array"
          },
          "self_control": {
            "anyOf": [
              {
                "enum": [
                  6,
                  9,
                  12,
                  15
                ],
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Self Control"
          },
          "modifiers": {
            "default": [],
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Modifiers",
            "type": "array"
          }
        },
        "title": "TraitOptions",
        "type": "object"
      },
      "ProfilePreviewRequest": {
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "title": "Profile Id",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "title": "Version",
            "type": "integer"
          },
          "proposal": {
            "$ref": "#/components/schemas/CharacterProposal"
          }
        },
        "required": [
          "profile_id",
          "version",
          "proposal"
        ],
        "title": "ProfilePreviewRequest",
        "type": "object"
      },
      "ProfilePreviewResult": {
        "additionalProperties": false,
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/ProfileOption"
          },
          "catalog": {
            "items": {
              "$ref": "#/components/schemas/CatalogOption"
            },
            "title": "Catalog",
            "type": "array"
          },
          "spent": {
            "title": "Spent",
            "type": "integer"
          },
          "remaining": {
            "title": "Remaining",
            "type": "integer"
          },
          "legal": {
            "title": "Legal",
            "type": "boolean"
          },
          "diagnostics": {
            "items": {
              "type": "string"
            },
            "title": "Diagnostics",
            "type": "array"
          },
          "derived": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "title": "Derived",
            "type": "array"
          }
        },
        "required": [
          "profile",
          "catalog",
          "spent",
          "remaining",
          "legal",
          "diagnostics",
          "derived"
        ],
        "title": "ProfilePreviewResult",
        "type": "object"
      },
      "AdvanceCharacter": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "actor_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor Id",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "expected_build_revision": {
            "title": "Expected Build Revision",
            "type": "string"
          },
          "draft": {
            "$ref": "#/components/schemas/CharacterDraft"
          },
          "reason": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "id",
          "actor_id",
          "expected_revision",
          "expected_build_revision",
          "draft",
          "reason"
        ],
        "title": "AdvanceCharacter",
        "type": "object"
      },
      "DraftCommand": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "draft_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Draft Id",
            "type": "string"
          },
          "actor_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Actor Id",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "expected_draft_revision": {
            "minimum": 0,
            "title": "Expected Draft Revision",
            "type": "integer"
          },
          "operation": {
            "default": "save",
            "enum": [
              "save",
              "approve",
              "activate"
            ],
            "title": "Operation",
            "type": "string"
          },
          "kind": {
            "default": "character",
            "enum": [
              "character",
              "scenario"
            ],
            "title": "Kind",
            "type": "string"
          },
          "content_json": {
            "anyOf": [
              {
                "maxLength": 100000,
                "type": "string"
              },
              {
                "type": "null"
              }
