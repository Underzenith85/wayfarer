          }
        },
        "required": [
          "id",
          "version"
        ],
        "title": "ProfileSelection",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Explicit host approval. Retries with the same ID replay the original receipt.",
    "properties": {
      "id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
