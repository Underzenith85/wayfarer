        "type": "string"
      },
      "reason": {
        "maxLength": 2000,
        "minLength": 1,
        "title": "Reason",
        "type": "string"
      }
    },
    "required": [
      "id",
      "expected_revision",
      "profile",
      "expected_from_digest",
      "reason"
    ],
    "title": "MigrateProfile",
    "type": "object"
  },
