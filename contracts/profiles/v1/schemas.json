{
  "ProfileSelection": {
    "additionalProperties": false,
    "description": "An exact registered profile. There is no latest-version selection.",
    "properties": {
      "id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "version": {
        "minimum": 1,
        "title": "Version",
        "type": "integer"
      }
    },
    "required": [
      "id",
      "version"
    ],
    "title": "ProfileSelection",
    "type": "object"
  },
  "ProfileView": {
    "$defs": {
      "PackageView": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "version": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          },
          "digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "dependencies": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "source_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          }
        },
        "required": [
          "id",
          "version",
          "digest"
        ],
        "title": "PackageView",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "version": {
        "minimum": 1,
        "title": "Version",
        "type": "integer"
      },
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "edition": {
        "maxLength": 100,
        "minLength": 1,
        "title": "Edition",
        "type": "string"
      },
      "digest": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Digest",
        "type": "string"
      },
      "supported": {
        "title": "Supported",
        "type": "boolean"
      },
      "conformance_profile_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Conformance Profile Id"
      },
      "packages": {
        "items": {
          "$ref": "#/$defs/PackageView"
        },
        "minItems": 1,
        "title": "Packages",
        "type": "array"
      },
      "policy_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Policy Id",
        "type": "string"
      },
      "policy_version": {
        "minimum": 1,
        "title": "Policy Version",
        "type": "integer"
      },
      "required_capabilities": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Required Capabilities",
        "type": "array"
      },
      "unverified_capabilities": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Unverified Capabilities",
        "type": "array"
      },
      "optional_rules": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Optional Rules",
        "type": "array"
      }
    },
    "required": [
      "id",
      "version",
      "title",
      "edition",
      "digest",
      "supported",
      "packages",
      "policy_id",
      "policy_version"
    ],
    "title": "ProfileView",
    "type": "object"
  },
  "ProfileMigrationPreview": {
