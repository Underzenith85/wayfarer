            },
            "title": "Added",
            "type": "array"
          },
          "removed": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Removed",
            "type": "array"
          },
          "changed_values": {
            "default": [],
            "items": {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            "title": "Changed Values",
            "type": "array"
          }
        },
        "required": [
          "actor_id",
          "old_revision",
          "new_revision",
          "old_spent",
          "new_spent"
        ],
        "title": "BuildDiff",
        "type": "object"
      },
      "Incompatibility": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "character",
              "resource",
              "scenario"
            ],
            "title": "Kind",
            "type": "string"
          },
          "reference": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Reference",
            "type": "string"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "reference",
          "message"
        ],
        "title": "Incompatibility",
        "type": "object"
      },
      "ProfileSelection": {
        "additionalProperties": false,
        "description": "An exact registered profile. There is no latest-version selection.",
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "title": "ProfileSelection",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "campaign_id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Campaign Id",
        "type": "string"
      },
      "revision": {
        "minimum": 0,
        "title": "Revision",
        "type": "integer"
      },
      "from_profile": {
        "$ref": "#/$defs/ProfileSelection"
      },
      "to_profile": {
        "$ref": "#/$defs/ProfileSelection"
      },
      "from_digest": {
        "title": "From Digest",
        "type": "string"
      },
      "to_digest": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "To Digest"
      },
      "actor_diffs": {
        "default": [],
        "items": {
          "$ref": "#/$defs/BuildDiff"
        },
        "title": "Actor Diffs",
        "type": "array"
      },
      "incompatibilities": {
        "default": [],
        "items": {
          "$ref": "#/$defs/Incompatibility"
        },
        "title": "Incompatibilities",
        "type": "array"
      }
    },
    "required": [
      "campaign_id",
      "revision",
      "from_profile",
      "to_profile",
      "from_digest"
    ],
    "title": "ProfileMigrationPreview",
    "type": "object"
  },
  "MigrateProfile": {
    "$defs": {
      "ProfileSelection": {
        "additionalProperties": false,
        "description": "An exact registered profile. There is no latest-version selection.",
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "version": {
            "minimum": 1,
            "title": "Version",
