{
  "$defs": {
    "DocumentReport": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "engine_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Digest",
          "type": "string"
        },
        "party_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Party Digest"
        },
        "status": {
          "enum": [
            "invalid",
            "needs-party",
            "playable"
          ],
          "title": "Status",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/StudioFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "content_digest",
        "engine_digest",
        "status",
        "findings"
      ],
      "title": "DocumentReport",
      "type": "object"
    },
    "StudioFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "reference",
        "message"
      ],
      "title": "StudioFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Persistence-ready draft aggregate, including structurally invalid source text.",
  "properties": {
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "edit": {
      "minimum": 1,
      "title": "Edit",
      "type": "integer"
    },
    "content_json": {
      "maxLength": 2000000,
      "title": "Content Json",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/DocumentReport"
    }
  },
  "required": [
    "id",
    "edit",
    "content_json",
    "source_digest",
    "report"
  ],
  "title": "DraftRevision",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
