            "title": "Kind",
            "type": "string"
          },
          "required_fact_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Required Fact Ids",
            "type": "array"
          },
          "reveal_fact_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Reveal Fact Ids",
            "type": "array"
          },
          "recipient_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Recipient Ids",
            "type": "array"
          },
          "cost_definition_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cost Definition Id"
          },
          "cost": {
            "default": 0,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Cost",
            "type": "integer"
          },
          "setback_rule_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Setback Rule Id"
          },
          "target_actor_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Actor Id"
          },
          "social": {
            "$ref": "#/$defs/NPCSocialTrigger"
          }
        },
        "required": [
