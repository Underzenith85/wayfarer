{
  "NPCSocialRules": {
    "$defs": {
      "NPCAction": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "patrol",
              "communicate",
              "alarm",
              "reinforce",
              "transfer_prisoner"
            ],
            "title": "Kind",
            "type": "string"
          },
          "required_fact_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Required Fact Ids",
            "type": "array"
          },
          "reveal_fact_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Reveal Fact Ids",
            "type": "array"
          },
          "recipient_ids": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "title": "Recipient Ids",
            "type": "array"
          },
          "cost_definition_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cost Definition Id"
          },
          "cost": {
            "default": 0,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Cost",
            "type": "integer"
          },
          "setback_rule_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Setback Rule Id"
          },
          "target_actor_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Actor Id"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "title": "NPCAction",
        "type": "object"
      },
      "NPCReputation": {
        "additionalProperties": false,
        "description": "One authored reputation; the engine owns its reaction value and recognition.",
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "level": {
            "maximum": 4,
            "minimum": -4,
            "title": "Level",
            "type": "integer"
          },
          "scope": {
            "default": "everyone",
            "enum": [
              "everyone",
              "large-class",
              "small-class"
            ],
            "title": "Scope",
            "type": "string"
          },
          "recognition": {
            "default": "always",
            "enum": [
              "always",
              "sometimes",
              "occasionally"
            ],
            "title": "Recognition",
            "type": "string"
          },
          "classes": {
            "default": [],
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Classes",
            "type": "array"
          },
          "hidden": {
            "default": false,
            "title": "Hidden",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "level"
        ],
        "title": "NPCReputation",
        "type": "object"
      },
      "NPCSocialAction": {
