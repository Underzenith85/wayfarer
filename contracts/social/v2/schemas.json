      "id": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Id",
        "type": "string"
      },
      "version": {
        "const": 2,
        "default": 2,
        "title": "Version",
        "type": "integer"
      },
      "plans": {
        "items": {
          "$ref": "#/$defs/NPCSocialPlan"
        },
        "maxItems": 50,
        "title": "Plans",
        "type": "array"
      },
      "checkpoint_budget": {
        "default": 100,
        "maximum": 1000,
        "minimum": 1,
        "title": "Checkpoint Budget",
        "type": "integer"
      }
    },
    "required": [
      "id",
      "plans"
    ],
    "title": "NPCSocialRules",
    "type": "object"
